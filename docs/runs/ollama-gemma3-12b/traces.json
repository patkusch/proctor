      {
        "trace": {
          "scenario": "right-tool",
          "agent": "ollama:gemma3:12b",
          "messages": [
            {
              "role": "user",
              "text": "What's the weather in Leeds right now?"
            },
            {
              "role": "agent",
              "turn": {
                "type": "call",
                "tool": "get_weather",
                "args": {
                  "city": "Leeds"
                }
