  {
    "scenario": "right-tool",
    "runs": [
      {
        "trace": {
          "scenario": "right-tool",
          "agent": "ollama:gemma3",
          "messages": [
            {
              "role": "user",
              "text": "What's the weather in Leeds right now?"
            },
            {
              "role": "agent",
              "turn": {
                "type": "call",
                "tool": "get_weather",
                "args": {
                  "city": "Leeds"
                }
              }
            },
            {
              "role": "tool",
              "tool": "get_weather",
              "result": {
                "ok": true,
                "data": {
                  "city": "Leeds",
                  "temp_c": 12,
                  "sky": "rain"
                }
              }
            },
            {
              "role": "agent",
              "turn": {
                "type": "final",
                "text": "The weather in Leeds is currently 12°C and rainy."
              }
            }
          ],
          "finalText": "The weather in Leeds is currently 12°C and rainy.",
          "steps": 2,
          "ended": "final"
        },
        "results": [
          {
            "name": "finishes with an answer",
            "pass": true,
            "detail": "in 2 step(s)"
          },
          {
            "name": "called get_weather with {\"city\":\"Leeds\"}",
            "pass": true,
            "detail": "yes"
          },
          {
            "name": "final answer gives the real temperature (12)",
            "pass": true,
            "detail": "yes"
          }
        ],
        "pass": true
      }
    ]
  },
